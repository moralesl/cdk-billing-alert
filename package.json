{
  "name": "@moralesl/billing-alert",
  "version": "0.5.0",
  "description": "Utility CDK construct to setup billing alerts easily",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "jsii",
    "build:watch": "jsii -w",
    "package": "jsii-pacmak",
    "watch": "tsc -w",
    "test": "jest",
    "test:watch": "jest -w"
  },
  "prepublish": "tsc",
  "devDependencies": {
    "aws-cdk-lib": "^2.0.0",
    "constructs": "^10.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "jsii": "^5.0.0",
    "jsii-pacmak": "^1.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "~5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "ts",
      "js"
    ],
    "testMatch": [
      "**/*.test.ts"
    ]
  },
  "jsii": {
    "outdir": "dist",
    "targets": {
      "python": {
        "distName": "moralesl.billing-alert",
        "module": "moralesl.billing_alert"
      }
    }
  },
  "author": {
    "name": "Luis Morales",
    "url": "https://github.com/moralesl"
  },
  "repository": {
    "url": "https://github.com/moralesl/cdk-billing-alert.git"
  },
  "keywords": [
    "aws",
    "cdk"
  ],
  "license": "MIT",
  "peerDependencies": {
    "aws-cdk-lib": "^2.0.0",
    "constructs": "^10.0.0"
  }
}
